datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hospital {
  contactNumber String?
  createdAt     DateTime @default(now())
  hospitalName  String?
  id            String   @id @default(cuid())
  location      String?
  typeField     String?
  updatedAt     DateTime @updatedAt
}

model MedicalRecord {
  createdAt     DateTime  @default(now())
  dateOfVisit   DateTime?
  doctorName    String?
  id            String    @id @default(cuid())
  recordDetails String?
  updatedAt     DateTime  @updatedAt
  user          User?     @relation(fields: [userId], references: [id])
  userId        String?
}

model InsurancePlan {
  coverageDetails String?
  createdAt       DateTime  @default(now())
  endDate         DateTime?
  id              String    @id @default(cuid())
  planName        String?
  startDate       DateTime?
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id])
  userId          String?
}

model User {
  address        String?
  createdAt      DateTime        @default(now())
  dateOfBirth    DateTime?
  email          String?         @unique
  firstName      String?
  id             String          @id @default(cuid())
  insurancePlans InsurancePlan[]
  lastName       String?
  medicalRecords MedicalRecord[]
  password       String
  phone          String?
  roles          Json
  updatedAt      DateTime        @updatedAt
  username       String          @unique
}
